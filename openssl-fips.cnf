config_diagnostics = 1
openssl_conf = openssl_init

# The entrypoint generates this private file on the deployed container host.
.include $ENV::OPENSSL_FIPS_CONFIG

[openssl_init]
providers = provider_sect
alg_section = algorithm_sect

[provider_sect]
fips = fips_sect
base = base_sect

[fips_sect]
module = $ENV::OPENSSL_FIPS_MODULE

[base_sect]
activate = 1

[algorithm_sect]
default_properties = fips=yes
